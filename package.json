{
  "name": "netatlas",
  "version": "0.2.0",
  "private": true,
  "description": "See the network policies of several Kubernetes clusters from one place.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --project unit",
    "test:package": "vitest run --project package",
    "build": "next build",
    "start:standalone": "node scripts/start-standalone.mjs",
    "e2e:standalone": "playwright test",
    "e2e:kind": "playwright test --config playwright.kind.config.ts",
    "screenshots": "playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/credential-providers": "3.1168.0",
    "@kubernetes/client-node": "2.0.2",
    "@smithy/signature-v4": "5.7.5",
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
